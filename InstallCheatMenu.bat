@echo off
title CheatMenu - Installer
rem Run the powershell script that sits below this file
set "CM_ROOT=%~dp0"
set "CM_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$s = [IO.File]::ReadAllText($env:CM_SELF); $code = ($s -split '(?m)^###PS###\r?$')[1]; Invoke-Expression $code"
echo.
pause
exit /b

###PS###
$ErrorActionPreference = 'Stop'

#Plugin file name
$js_name   = 'CheatMenu.js'
$entry     = '{"name":"CheatMenu","status":true,"description":"","parameters":{"ToggleKey":"F9"}}'
$root      = $env:CM_ROOT.TrimEnd('\')
$utf8      = New-Object System.Text.UTF8Encoding($false)

#Backup plugins.js only once
function Make-Bak($file) {
    if (-not (Test-Path -LiteralPath "$file.bak")) { Copy-Item -LiteralPath $file -Destination "$file.bak" }
}

try {
    #Find plugins.js (MV: www\js, MZ: js)
    $path = @("$root\www\js\plugins.js", "$root\js\plugins.js") |
        Where-Object { Test-Path -LiteralPath $_ } | Select-Object -First 1
    $was_created = $false
    if (-not $path) {
        if ((Test-Path "$root\js") -and -not (Test-Path "$root\www")) { $path = "$root\js\plugins.js" }
        else { $path = "$root\www\js\plugins.js" }
        New-Item -ItemType Directory -Force -Path (Split-Path $path) | Out-Null
        $was_created = $true
    }
    $plugin_dir = Join-Path (Split-Path $path) 'plugins'

    #Move CheatMenu.js to the plugins folder
    $src   = Join-Path $root $js_name
    $dst = Join-Path $plugin_dir $js_name
    New-Item -ItemType Directory -Force -Path $plugin_dir | Out-Null
    if (Test-Path -LiteralPath $src) {
        Move-Item -LiteralPath $src -Destination $dst -Force
        Write-Host "Moved $js_name to $plugin_dir"
    }
    elseif (Test-Path -LiteralPath $dst) {
        Write-Host "$js_name is already in the plugins folder."
    }
    else {
        Write-Host "WARNING: $js_name was not found next to this installer. Put it in the same folder and run again." -ForegroundColor Yellow
    }

    #plugins.js doesn't exist, make a new one
    if ($was_created) {
        $new_content = "// Generated by RPG Maker.`n// Do not edit this file directly.`nvar `$plugins =`n[`n$entry`n];`n"
        [IO.File]::WriteAllText($path, $new_content, $utf8)
        Write-Host "plugins.js was missing, so a new one was created: $path"
        return
    }

    $text = [IO.File]::ReadAllText($path, $utf8)

    #Already installed, nothing to do
    if ($text -match '"name"\s*:\s*"CheatMenu"') {
        Write-Host "CheatMenu is already in plugins.js."
        return
    }

    #Use the same line ending as the file (RPG Maker uses LF)
    $nl = "`n"
    if ($text.Contains("`r`n")) { $nl = "`r`n" }

    $last = $text.LastIndexOf(']')
    if ($last -lt 0) { throw "Could not find the closing ] of the plugin list in $path" }

    Make-Bak $path

    #Put the entry on the last line, the comma goes on the line before
    $head = $text.Substring(0, $last).TrimEnd()
    $tail   = $text.Substring($last)
    if (-not ($head.EndsWith('[') -or $head.EndsWith(','))) { $head += ',' }

    [IO.File]::WriteAllText($path, $head + $nl + $entry + $nl + $tail, $utf8)

    Write-Host "Added CheatMenu as the last entry in: $path"
    Write-Host "(Original saved as plugins.js.bak)"
    Write-Host ""
    Write-Host "All done. Launch the game and press F9 to start."
}
catch {
    Write-Host "ERROR: $($_.Exception.Message)" -ForegroundColor Red
}